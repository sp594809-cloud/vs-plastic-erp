<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark">Party Ledger Statement</h1>
    </div>
    <div class="col-sm-6 text-end">
        <a href="/reports" class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Reports
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card mb-4 no-print">
    <div class="card-header bg-light">Select Party & Period</div>
    <div class="card-body">
        <form action="/reports/party-ledger" method="GET">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Party Account <span class="text-danger">*</span></label>
                    <select name="party_id" class="form-select select2" required>
                        <option value="">-- Choose Party --</option>
                        <% parties.forEach(pty => { %>
                            <option value="<%= pty.id %>" <%= filters.party_id == pty.id ? 'selected' : '' %>><%= pty.name %> (<%= pty.type %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">Start Date</label>
                    <input type="date" name="start_date" class="form-control" value="<%= filters.start_date %>">
                </div>
                <div class="col-md-3 mb-3">
                    <label class="form-label">End Date</label>
                    <input type="date" name="end_date" class="form-control" value="<%= filters.end_date %>">
                </div>
                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-magnifying-glass me-1"></i>View Ledger
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<% if (activeParty) { %>
    <!-- Ledger Sheet -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center bg-light">
            <span>Statement of Account: <strong><%= activeParty.name %></strong></span>
            <span class="badge bg-secondary">Period: <%= new Date(filters.start_date).toLocaleDateString('en-GB') %> to <%= new Date(filters.end_date).toLocaleDateString('en-GB') %></span>
        </div>
        
        <div class="card-body">
            <!-- Party Profile Details -->
            <div class="row mb-4 border-bottom pb-3">
                <div class="col-md-6">
                    <strong>Billing Address:</strong><br>
                    <%= activeParty.address || 'N/A' %><br>
                    <strong>Contact:</strong> <%= activeParty.contact_person %> | Mobile: <%= activeParty.mobile || '-' %>
                </div>
                <div class="col-md-6 text-end">
                    <strong>GSTIN:</strong> <%= activeParty.gstin || 'N/A' %><br>
                    <strong>State Code:</strong> <%= activeParty.state_code || '-' %> (<%= activeParty.state || '-' %>)
                </div>
            </div>

            <div class="table-responsive">
                <table id="ledgerTable" class="table table-bordered align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Voucher Type</th>
                            <th>Doc / Ref No.</th>
                            <th>Description</th>
                            <th class="text-end">Debit (Dr) / Charges (+)</th>
                            <th class="text-end">Credit (Cr) / Receipts (-)</th>
                            <th class="text-end">Outstanding Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- 1. Opening Balance Row -->
                        <tr class="table-secondary fw-bold">
                            <td><%= new Date(filters.start_date).toLocaleDateString('en-GB') %></td>
                            <td colspan="3">Opening Balance</td>
                            <td class="text-end">
                                <%= openingBalance >= 0 ? '₹' + openingBalance.toFixed(2) : '-' %>
                            </td>
                            <td class="text-end">
                                <%= openingBalance < 0 ? '₹' + Math.abs(openingBalance).toFixed(2) : '-' %>
                            </td>
                            <td class="text-end">
                                ₹<%= Math.abs(openingBalance).toFixed(2) %>
                                <%= openingBalance >= 0 ? 'Dr' : 'Cr' %>
                            </td>
                        </tr>

                        <!-- 2. Ledger Entries -->
                        <% let runningBal = openingBalance; %>
                        <% let totalDebits = 0, totalCredits = 0; %>
                        <% transactions.forEach(tx => { %>
                            <% runningBal += (tx.debit - tx.credit); %>
                            <% totalDebits += tx.debit; %>
                            <% totalCredits += tx.credit; %>
                            <tr>
                                <td><%= new Date(tx.date).toLocaleDateString('en-GB') %></td>
                                <td><span class="badge bg-light text-dark border"><%= tx.voucher_type %></span></td>
                                <td class="fw-bold"><%= tx.ref_no %></td>
                                <td><%= tx.description %></td>
                                <td class="text-end text-success">
                                    <%= tx.debit > 0 ? '₹' + tx.debit.toFixed(2) : '-' %>
                                </td>
                                <td class="text-end text-danger">
                                    <%= tx.credit > 0 ? '₹' + tx.credit.toFixed(2) : '-' %>
                                </td>
                                <td class="text-end fw-bold">
                                    ₹<%= Math.abs(runningBal).toFixed(2) %>
                                    <%= runningBal >= 0 ? 'Dr' : 'Cr' %>
                                </td>
                            </tr>
                        <% }) %>

                        <!-- 3. Totals and Closing Balance Row -->
                        <tr class="table-light fw-bold">
                            <td colspan="4" class="text-center">Total Debit/Credit Movements</td>
                            <td class="text-end text-success">₹<%= totalDebits.toFixed(2) %></td>
                            <td class="text-end text-danger">₹<%= totalCredits.toFixed(2) %></td>
                            <td class="text-end table-dark">
                                Closing: ₹<%= Math.abs(runningBal).toFixed(2) %>
                                <%= runningBal >= 0 ? 'Dr' : 'Cr' %>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
<% } else { %>
    <div class="alert alert-info text-center p-4">
        <i class="fa-solid fa-address-book fs-3 mb-2 d-block"></i>
        Please select a party and date range above to load their ledger statement.
    </div>
<% } %>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        if ($('#ledgerTable').length) {
            $('#ledgerTable').DataTable({
                language: window.dtLanguageConfig,
                dom: 'Bfrtip',
                buttons: [
                    {
                        extend: 'excelHtml5',
                        text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                        className: 'btn btn-success btn-sm',
                        title: '<%= activeParty ? activeParty.name : "Party" %>_Ledger'
                    },
                    {
                        extend: 'pdfHtml5',
                        text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                        className: 'btn btn-danger btn-sm',
                        title: '<%= activeParty ? activeParty.name : "Party" %>_Ledger'
                    },
                    {
                        extend: 'print',
                        text: '<i class="fa-solid fa-print me-1"></i> Print',
                        className: 'btn btn-dark btn-sm'
                    }
                ],
                paging: false,
                ordering: false,
                searching: false
            });
        }
    });
</script>

<%- include('../layouts/footer') %>
