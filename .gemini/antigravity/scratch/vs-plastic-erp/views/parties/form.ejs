<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3">
    <div class="col-sm-12">
        <h1 class="m-0 text-dark"><%= isEdit ? __('Edit Party') : __('Add Party') %></h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form action="<%= isEdit ? '/master/party/edit/' + party.id : '/master/party/add' %>" method="POST" id="partyForm">
            <div class="row">
                <!-- Party Name -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Party Name') %> <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" value="<%= isEdit ? party.name : '' %>" required placeholder="Enter Party Name">
                </div>

                <!-- Party Type -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Type') %> <span class="text-danger">*</span></label>
                    <select name="type" class="form-select select2" required>
                        <option value="Customer" <%= isEdit && party.type === 'Customer' ? 'selected' : '' %>><%= __('Customer') %></option>
                        <option value="Supplier" <%= isEdit && party.type === 'Supplier' ? 'selected' : '' %>><%= __('Supplier') %></option>
                        <option value="Both" <%= isEdit && party.type === 'Both' ? 'selected' : '' %>><%= __('Both') %></option>
                    </select>
                </div>

                <!-- GST Number -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('GST Number') %> <span class="text-danger">*</span></label>
                    <input type="text" name="gstin" id="gstin" class="form-control text-uppercase" value="<%= isEdit ? party.gstin : '' %>" placeholder="e.g. 24AABCV1234F1Z1" maxlength="15" required pattern="[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}" title="Enter valid 15-character GSTIN (e.g. 24AABCV1234F1Z1)">
                    <small class="text-muted">Mandatory. GST state & code auto-fill from first 2 digits.</small>
                </div>

                <!-- GST State -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('GST State') %></label>
                    <select name="state" id="state" class="form-select select2">
                        <option value="">Select State</option>
                        <% statesList.forEach(st => { %>
                            <option value="<%= st.name %>" data-code="<%= st.code %>" <%= isEdit && party.state === st.name ? 'selected' : '' %>><%= st.name %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- GST State Code -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('GST State Code') %></label>
                    <input type="text" name="state_code" id="state_code" class="form-control" value="<%= isEdit ? party.state_code : '' %>" readonly placeholder="Auto-filled">
                </div>

                <!-- Contact Person -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('Contact Person') %></label>
                    <input type="text" name="contact_person" class="form-control" value="<%= isEdit ? party.contact_person : '' %>" placeholder="Enter Contact Name">
                </div>

                <!-- Mobile -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('Mobile') %></label>
                    <input type="text" name="mobile" class="form-control" value="<%= isEdit ? party.mobile : '' %>" placeholder="Enter Mobile Number">
                </div>

                <!-- Email -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('Email') %></label>
                    <input type="email" name="email" class="form-control" value="<%= isEdit ? party.email : '' %>" placeholder="Enter Email Address">
                </div>

                <!-- Opening Balance -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Opening Balance') %></label>
                    <input type="number" step="0.01" name="opening_balance" class="form-control" value="<%= isEdit ? Math.abs(party.opening_balance) : '0.00' %>">
                </div>

                <!-- Balance Type -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Balance Type') %></label>
                    <select name="balance_type" class="form-select select2">
                        <option value="Dr" <%= isEdit && party.balance_type === 'Dr' ? 'selected' : '' %>>Receivable (Debit - Dr)</option>
                        <option value="Cr" <%= isEdit && party.balance_type === 'Cr' ? 'selected' : '' %>>Payable (Credit - Cr)</option>
                    </select>
                </div>

                <!-- Billing Address -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Address') %></label>
                    <textarea name="address" id="address" class="form-control" rows="3" placeholder="Enter Billing Address"><%= isEdit ? party.address : '' %></textarea>
                    <button type="button" class="btn btn-sm btn-link p-0 mt-1" id="copyAddressBtn">Copy to Shipping Address</button>
                </div>

                <!-- Shipping Address -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Shipping Address') %></label>
                    <textarea name="shipping_address" id="shipping_address" class="form-control" rows="3" placeholder="Enter Shipping Address"><%= isEdit ? party.shipping_address : '' %></textarea>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 border-top pt-3 text-end">
                <a href="/master/party" class="btn btn-secondary me-2"><%= __('Cancel') %></a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i><%= __('Save') %>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- GSTIN Auto-fill State code Script -->
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const gstinInput = document.getElementById("gstin");
        const stateSelect = document.getElementById("state");
        const stateCodeInput = document.getElementById("state_code");
        const addressText = document.getElementById("address");
        const shippingText = document.getElementById("shipping_address");
        const copyBtn = document.getElementById("copyAddressBtn");

        // Copy Address helper
        copyBtn.addEventListener("click", function() {
            shippingText.value = addressText.value;
        });

        // Watch State dropdown changes
        $(stateSelect).on('change', function() {
            const selectedOption = stateSelect.options[stateSelect.selectedIndex];
            if (selectedOption) {
                const code = selectedOption.getAttribute('data-code') || '';
                stateCodeInput.value = code;
            } else {
                stateCodeInput.value = '';
            }
        });

        // GSTIN parser
        gstinInput.addEventListener("input", function() {
            let val = gstinInput.value.trim();
            if (val.length >= 2) {
                const prefix = val.substring(0, 2);
                
                // Search for option matching data-code
                let found = false;
                for (let i = 0; i < stateSelect.options.length; i++) {
                    const opt = stateSelect.options[i];
                    if (opt.getAttribute('data-code') === prefix) {
                        stateSelect.selectedIndex = i;
                        $(stateSelect).trigger('change'); // Notify Select2
                        stateCodeInput.value = prefix;
                        found = true;
                        break;
                    }
                }
                
                if (!found && /^\d+$/.test(prefix)) {
                    stateCodeInput.value = prefix;
                }
            }
        });
    });
</script>

<%- include('../layouts/header') %>
