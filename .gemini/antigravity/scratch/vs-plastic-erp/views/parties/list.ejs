<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark"><%= __('Party List') %></h1>
    </div>
    <div class="col-sm-6 text-end">
        <a href="/master/party/add" class="btn btn-primary">
            <i class="fa-solid fa-plus me-1"></i><%= __('Add Party') %>
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="partiesTable" class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th><%= __('Party Name') %></th>
                        <th><%= __('Type') %></th>
                        <th><%= __('GST Number') %></th>
                        <th><%= __('GST State') %> (Code)</th>
                        <th><%= __('Mobile') %></th>
                        <th><%= __('Contact Person') %></th>
                        <th class="text-end"><%= __('Current Balance') %></th>
                        <th class="text-center no-print"><%= __('Actions') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% parties.forEach(party => { %>
                        <tr>
                            <td class="fw-bold"><%= party.name %></td>
                            <td>
                                <% if (party.type === 'Customer') { %>
                                    <span class="badge bg-success"><%= __('Customer') %></span>
                                <% } else if (party.type === 'Supplier') { %>
                                    <span class="badge bg-danger"><%= __('Supplier') %></span>
                                <% } else { %>
                                    <span class="badge bg-warning text-dark"><%= __('Both') %></span>
                                <% } %>
                            </td>
                            <td><%= party.gstin || '-' %></td>
                            <td><%= party.state || '-' %> (<%= party.state_code || '-' %>)</td>
                            <td><%= party.mobile || '-' %></td>
                            <td><%= party.contact_person || '-' %></td>
                            <td class="text-end fw-bold">
                                <span class="<%= party.current_balance >= 0 ? 'text-success' : 'text-danger' %>">
                                    ₹<%= Math.abs(party.current_balance).toFixed(2) %>
                                    <%= party.current_balance >= 0 ? 'Dr' : 'Cr' %>
                                </span>
                            </td>
                            <td class="text-center no-print">
                                <a href="/master/party/edit/<%= party.id %>" class="btn btn-sm btn-info text-white me-1" title="<%= __('Edit') %>">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <a href="/master/party/delete/<%= party.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this party?');" title="<%= __('Delete') %>">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Initialize DataTable with CSV/Excel/PDF/Print buttons -->
<script>
    window.addEventListener('DOMContentLoaded', () => {
        $('#partiesTable').DataTable({
            language: window.dtLanguageConfig,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                    className: 'btn btn-success btn-sm',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                    className: 'btn btn-danger btn-sm',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                },
                {
                    extend: 'print',
                    text: '<i class="fa-solid fa-print me-1"></i> Print',
                    className: 'btn btn-dark btn-sm',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5, 6] }
                }
            ],
            pageLength: 10,
            order: [[0, 'asc']]
        });
    });
</script>

<%- include('../layouts/footer') %>
