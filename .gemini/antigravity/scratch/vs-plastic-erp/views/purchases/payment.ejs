<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark"><%= __('Purchase Payment') %></h1>
    </div>
</div>

<div class="row">
    <!-- Record Payment Form (Left Column) -->
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header bg-light">
                <i class="fa-solid fa-square-plus me-2 text-danger"></i>Record Supplier Outflow
            </div>
            <div class="card-body">
                <form action="/purchase/payment/add" method="POST" id="paymentForm">
                    <!-- Party Select (Supplier) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><%= __('Select Party') %> <span class="text-danger">*</span></label>
                        <select name="party_id" id="payment_party_id" class="form-select select2" required>
                            <option value="">-- Choose Supplier --</option>
                            <% parties.forEach(pty => { %>
                                <option value="<%= pty.id %>" data-balance="<%= pty.current_balance %>"><%= pty.name %></option>
                            <% }) %>
                        </select>
                        <div class="mt-2" id="partyOutstandingDisplay" style="display:none;">
                            <small class="text-muted">Current Balance: <strong id="outstandingAmt" class="text-danger">₹0.00 Cr</strong></small>
                        </div>
                    </div>

                    <!-- Invoice Link (Optional) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold">Link to Bill (Optional)</label>
                        <select name="purchase_invoice_id" id="payment_invoice_id" class="form-select select2">
                            <option value="">-- Direct Ledger Debit --</option>
                        </select>
                    </div>

                    <!-- Payment Mode -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><%= __('Payment Mode') %> <span class="text-danger">*</span></label>
                        <select name="payment_mode" id="payment_mode" class="form-select select2" required>
                            <option value="Cash">Cash</option>
                            <option value="Bank">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                            <option value="UPI">UPI / GPay / PhonePe</option>
                        </select>
                    </div>

                    <!-- Bank Account Select (if Bank/Cheque/UPI) -->
                    <div class="mb-3 d-none" id="bankSelectDiv">
                        <label class="form-label fw-bold">Withdraw from Bank Account <span class="text-danger">*</span></label>
                        <select name="bank_id" id="bank_id" class="form-select select2">
                            <option value="">-- Select Bank Account --</option>
                            <% banks.forEach(bk => { %>
                                <option value="<%= bk.id %>"><%= bk.name %> (A/C: ...<%= bk.ac_no.slice(-4) %>)</option>
                            <% }) %>
                        </select>
                    </div>

                    <!-- Reference No -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><%= __('Reference No') %> (UPI / Cheque / Tx ID)</label>
                        <input type="text" name="reference_no" class="form-control" placeholder="Enter Ref / Tx ID">
                    </div>

                    <!-- Amount -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><%= __('Amount Paid') %> (₹) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="amount" id="payment_amount" class="form-control" required min="0.01" placeholder="0.00">
                    </div>

                    <!-- Date -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><%= __('Date') %> <span class="text-danger">*</span></label>
                        <input type="date" name="date" class="form-control" value="<%= todayDate %>" required>
                    </div>

                    <!-- Notes -->
                    <div class="mb-3">
                        <label class="form-label fw-bold"><%= __('Notes') %></label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Payment remarks..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-danger w-100">
                        <i class="fa-solid fa-circle-check me-1"></i>Save Payment
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Payments Ledger List (Right Column) -->
    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header bg-light">
                <i class="fa-solid fa-list-ul me-2 text-danger"></i>Recent Payments History
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="paymentsTable" class="table table-bordered table-striped table-hover align-middle">
                        <thead>
                            <tr>
                                <th><%= __('Date') %></th>
                                <th><%= __('Party Name') %></th>
                                <th>Bill Link</th>
                                <th>Mode</th>
                                <th class="text-end">Amount Paid</th>
                                <th class="text-center no-print"><%= __('Actions') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% payments.forEach(pay => { %>
                                <tr>
                                    <td><%= new Date(pay.date).toLocaleDateString('en-GB') %></td>
                                    <td class="fw-bold"><%= pay.party_name %></td>
                                    <td>
                                        <% if (pay.invoice_no) { %>
                                            <span class="fw-bold text-success"><%= pay.invoice_no %></span>
                                        <% } else { %>
                                            <span class="text-muted">Direct Ledger</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary"><%= pay.payment_mode %></span>
                                        <% if (pay.reference_no) { %>
                                            <div class="text-muted" style="font-size:0.8rem;"><%= pay.reference_no %></div>
                                        <% } %>
                                    </td>
                                    <td class="text-end fw-bold text-danger">₹<%= pay.amount.toFixed(2) %></td>
                                    <td class="text-center no-print">
                                        <a href="/purchase/payment/delete/<%= pay.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this payment? This will revert the supplier balance.');">
                                            <i class="fa-solid fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        $('#payment_mode').on('change', function() {
            const mode = $(this).val();
            if (mode === 'Cash') {
                $('#bankSelectDiv').addClass('d-none');
                $('#bank_id').attr('required', false);
            } else {
                $('#bankSelectDiv').removeClass('d-none');
                $('#bank_id').attr('required', true);
            }
        });

        $('#payment_party_id').on('change', function() {
            const partyId = $(this).val();
            const selectedOpt = $(this).find(':selected');
            
            if (!partyId) {
                $('#partyOutstandingDisplay').hide();
                $('#payment_invoice_id').html('<option value="">-- Direct Ledger Debit --</option>');
                return;
            }

            const balance = parseFloat(selectedOpt.data('balance')) || 0;
            const balText = balance >= 0 ? `₹${balance.toFixed(2)} Dr (Receivable)` : `₹${Math.abs(balance).toFixed(2)} Cr (Payable)`;
            $('#outstandingAmt').text(balText);
            $('#outstandingAmt').removeClass('text-success text-danger').addClass(balance >= 0 ? 'text-success' : 'text-danger');
            $('#partyOutstandingDisplay').show();

            // Load outstanding purchase invoices for this supplier
            $.get(`/api/outstanding-purchase-invoices/${partyId}`, function(invoices) {
                let options = '<option value="">-- Direct Ledger Debit --</option>';
                invoices.forEach(inv => {
                    options += `<option value="${inv.id}" data-total="${inv.grand_total}">Bill: ${inv.invoice_no} (Total: ₹${inv.grand_total.toFixed(2)})</option>`;
                });
                $('#payment_invoice_id').html(options);
            });
        });

        $('#paymentsTable').DataTable({
            language: window.dtLanguageConfig,
            order: [[0, 'desc']]
        });
    });
</script>

<%- include('../layouts/footer') %>
