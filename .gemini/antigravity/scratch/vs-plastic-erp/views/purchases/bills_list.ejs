<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark"><%= __('Purchase') %> Invoice List</h1>
    </div>
    <div class="col-sm-6 text-end">
        <a href="/purchase/bill/add" class="btn btn-success">
            <i class="fa-solid fa-plus me-1"></i>Add Purchase Bill
        </a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="purchaseTable" class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Supplier Bill No.</th>
                        <th><%= __('Party Name') %></th>
                        <th><%= __('Date') %></th>
                        <th class="text-end"><%= __('Sub Total') %></th>
                        <th class="text-end"><%= __('Tax Total') %></th>
                        <th class="text-end"><%= __('Grand Total') %></th>
                        <th class="text-center no-print" style="width: 15%;"><%= __('Actions') %></th>
                    </tr>
                </thead>
                <tbody>
                    <% invoices.forEach(inv => { %>
                        <tr>
                            <td class="fw-bold"><%= inv.invoice_no %></td>
                            <td><%= inv.party_name %></td>
                            <td><%= new Date(inv.date).toLocaleDateString('en-GB') %></td>
                            <td class="text-end">₹<%= inv.sub_total.toFixed(2) %></td>
                            <td class="text-end">₹<%= inv.tax_total.toFixed(2) %></td>
                            <td class="text-end fw-bold text-success">₹<%= inv.grand_total.toFixed(2) %></td>
                            <td class="text-center no-print">
                                <!-- Edit -->
                                <a href="/purchase/bill/edit/<%= inv.id %>" class="btn btn-sm btn-info text-white me-1" title="<%= __('Edit') %>">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                                <!-- Pay -->
                                <a href="/purchase/payment/add?invoice_id=<%= inv.id %>" class="btn btn-sm btn-success me-1" title="Pay Supplier">
                                    <i class="fa-solid fa-money-bill-wave"></i>
                                </a>
                                <!-- Delete -->
                                <a href="/purchase/bill/delete/<%= inv.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to delete this purchase bill? This will reverse the stock levels.');" title="<%= __('Delete') %>">
                                    <i class="fa-solid fa-trash"></i>
                                </a>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        $('#purchaseTable').DataTable({
            language: window.dtLanguageConfig,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                    className: 'btn btn-success btn-sm',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                    className: 'btn btn-danger btn-sm',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                },
                {
                    extend: 'print',
                    text: '<i class="fa-solid fa-print me-1"></i> Print',
                    className: 'btn btn-dark btn-sm',
                    exportOptions: { columns: [0, 1, 2, 3, 4, 5] }
                }
            ],
            pageLength: 10,
            order: [[2, 'desc'], [0, 'desc']]
        });
    });
</script>

<%- include('../layouts/footer') %>
