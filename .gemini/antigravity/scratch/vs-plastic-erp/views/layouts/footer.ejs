<!-- Menu Toggle & Bootstrap Toast Initialization -->
<script>
    $(document).ready(function() {
        // Phone: start with sidebar closed
        if (window.matchMedia('(max-width: 991.98px)').matches) {
            $('#sidebar-wrapper').addClass('collapsed');
        }

        // Toggle Sidebar
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#sidebar-wrapper").toggleClass("collapsed");
        });

        // Initialize Select2 dropdowns
        $('.select2').select2({
            width: '100%'
        });

        // Init sales/purchase bill form product rows (must run after Select2 is ready)
        if (typeof window.initBillFormPage === 'function') {
            window.initBillFormPage();
        }

        // Initialize Bootstrap Toasts
        var toastElList = [].slice.call(document.querySelectorAll('.toast'));
        var toastList = toastElList.map(function(toastEl) {
            return new bootstrap.Toast(toastEl, { delay: 4000 });
        });
        toastList.forEach(toast => toast.show());

        // Setup Datatables defaults for Excel, PDF, Print export with EN/GU translations
        const isGu = "<%= currentLang %>" === "gu";
        const dtLanguage = isGu ? {
            "sProcessing":   "પ્રક્રિયા ચાલુ છે...",
            "sLengthMenu":   "પૃષ્ઠ દીઠ _MENU_ પ્રવેશો દર્શાવો",
            "sZeroRecords":  "કોઈ રેકોર્ડ મળ્યા નથી",
            "sInfo":         "કુલ _TOTAL_ રેકોર્ડ્સમાંથી _START_ થી _END_ દર્શાવે છે",
            "sInfoEmpty":    "0 રેકોર્ડ્સ દર્શાવે છે",
            "sInfoFiltered": "(કુલ _MAX_ રેકોર્ડ્સમાંથી ફિલ્ટર કરેલ)",
            "sInfoPostFix":  "",
            "sSearch":       "શોધો:",
            "sUrl":          "",
            "oPaginate": {
                "sFirst":    "પ્રથમ",
                "sPrevious": "પાછળનું",
                "sNext":     "આગળનું",
                "sLast":     "છેલ્લું"
            }
        } : {};

        // Expose translation helper and language configs to specific page scripts
        window.dtLanguageConfig = dtLanguage;
    });

    
    // Mobile sidebar overlay close on link click
    $(document).on('click', '#sidebar-wrapper .nav-link', function() {
        if (window.innerWidth < 992) {
            $('#sidebar-wrapper').addClass('collapsed');
            $('#sidebar-overlay').removeClass('show');
        }
    });
    $('#menu-toggle').off('click').on('click', function(e) {
        e.preventDefault();
        $('#sidebar-wrapper').toggleClass('collapsed');
        $('#sidebar-overlay').toggleClass('show');
    });
    $(document).on('click', '#sidebar-overlay', function() {
        $('#sidebar-wrapper').addClass('collapsed');
        $('#sidebar-overlay').removeClass('show');
    });

    
    // PWA install prompt
    let deferredInstallPrompt = null;
    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredInstallPrompt = e;
        const banner = document.getElementById('pwaInstallBanner');
        if (banner && !localStorage.getItem('pwaInstallDismissed')) {
            banner.classList.add('show');
        }
    });
    document.getElementById('pwaInstallBtn')?.addEventListener('click', async () => {
        if (!deferredInstallPrompt) return;
        deferredInstallPrompt.prompt();
        await deferredInstallPrompt.userChoice;
        deferredInstallPrompt = null;
        document.getElementById('pwaInstallBanner')?.classList.remove('show');
    });
    document.getElementById('pwaInstallDismiss')?.addEventListener('click', () => {
        localStorage.setItem('pwaInstallDismissed', '1');
        document.getElementById('pwaInstallBanner')?.classList.remove('show');
    });

    // PWA Service Worker Registration
    if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
            navigator.serviceWorker.register('/service-worker.js')
                .then(reg => console.log('Service Worker registered successfully!', reg.scope))
                .catch(err => console.error('Service Worker registration failed:', err));
        });
    }
</script>
</body>
</html>
