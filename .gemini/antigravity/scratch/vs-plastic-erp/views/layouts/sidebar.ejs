<!-- Page Content -->
<div id="sidebar-overlay" class="sidebar-overlay no-print"></div>
<div id="page-content-wrapper">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg top-navbar no-print">
        <div class="container-fluid">
            <button class="btn btn-outline-secondary me-3" id="menu-toggle">
                <i class="fa-solid fa-bars"></i>
            </button>
            
            <div class="navbar-brand"><%= companyName || 'VS Plastic' %></div>
            
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    <!-- Language Switcher -->
                    <li class="nav-item dropdown me-3">
                        <a class="nav-link dropdown-toggle btn btn-sm btn-light px-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-language me-1 text-primary"></i>
                            <%= currentLang === 'en' ? 'English' : 'ગુજરાતી' %>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/lang/en">English</a></li>
                            <li><a class="dropdown-item" href="/lang/gu">ગુજરાતી</a></li>
                        </ul>
                    </li>
                    
                    <!-- User Account -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-circle-user fs-4 me-2 text-secondary"></i>
                            <span class="fw-semibold"><%= username %></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item text-danger" href="/logout">
                                    <i class="fa-solid fa-right-from-bracket me-2"></i><%= __('Logout') %>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Area -->
    <div class="container-fluid p-4">
        <!-- Toast notifications placeholder -->
        <div class="toast-container position-fixed top-0 end-0 p-3">
            <% if (typeof success_msg !== 'undefined' && success_msg) { %>
                <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fa-solid fa-circle-check me-2"></i><%= success_msg %>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            <% } %>
            <% if (typeof error_msg !== 'undefined' && error_msg) { %>
                <div class="toast show align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
                    <div class="d-flex">
                        <div class="toast-body">
                            <i class="fa-solid fa-circle-exclamation me-2"></i><%= error_msg %>
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                </div>
            <% } %>
        </div>
