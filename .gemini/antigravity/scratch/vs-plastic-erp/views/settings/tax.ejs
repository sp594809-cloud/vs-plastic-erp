<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark">Tax Rates Settings</h1>
    </div>
</div>

<div class="row">
    <!-- Add Tax -->
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header bg-light">Create Tax Slab</div>
            <div class="card-body">
                <form action="/settings/tax/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tax Slab Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. GST 18%" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tax Percentage (%) <span class="text-danger">*</span></label>
                        <input type="number" step="0.01" name="rate_percent" class="form-control" placeholder="e.g. 18.00" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-plus me-1"></i>Add Tax Slab
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Taxes List -->
    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header bg-light">Registered Tax Slabs</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tax Name</th>
                                <th class="text-end">Tax Rate (%)</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% taxes.forEach(tx => { %>
                                <tr>
                                    <td class="fw-bold"><%= tx.name %></td>
                                    <td class="text-end"><%= tx.rate_percent %>%</td>
                                    <td class="text-center">
                                        <a href="/settings/tax/delete/<%= tx.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this tax slab?');">
                                            <i class="fa-solid fa-trash me-1"></i>Delete
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
