<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark">Measurement Units Settings</h1>
    </div>
</div>

<div class="row">
    <!-- Add Unit -->
    <div class="col-md-4 mb-4">
        <div class="card">
            <div class="card-header bg-light">Create Unit</div>
            <div class="card-body">
                <form action="/settings/unit/add" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Unit Name <span class="text-danger">*</span></label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Bag, Kg, Pcs" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa-solid fa-plus me-1"></i>Add Unit
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Units List -->
    <div class="col-md-8 mb-4">
        <div class="card">
            <div class="card-header bg-light">Registered Units</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Unit Name</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% units.forEach(un => { %>
                                <tr>
                                    <td class="fw-bold"><%= un.name %></td>
                                    <td class="text-center">
                                        <a href="/settings/unit/delete/<%= un.id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this unit?');">
                                            <i class="fa-solid fa-trash me-1"></i>Delete
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../layouts/footer') %>
