<%- include('layouts/header') %>
<%- include('layouts/sidebar') %>

<!-- Content Header -->
<div class="row mb-3">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark"><%= __('Dashboard') %></h1>
    </div>
    <div class="col-sm-6 text-end">
        <span class="badge bg-secondary p-2">
            <i class="fa-solid fa-calendar me-1"></i>
            <%= __('Active Year') %>: <%= activeYear %>
        </span>
    </div>
</div>

<!-- Small boxes (Stat box) -->
<div class="row">
    <!-- Sales Box -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-primary">
            <div class="inner">
                <h3><%= stats.salesCount %></h3>
                <p><%= __('Sales Orders') %></p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <a href="/sales/bill" class="small-box-footer">
                More info <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    
    <!-- Purchase Box -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3><%= stats.purchaseCount %></h3>
                <p><%= __('Purchase Orders') %></p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-file-invoice"></i>
            </div>
            <a href="/purchase/bill" class="small-box-footer">
                More info <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    
    <!-- Parties Box -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning text-white">
            <div class="inner">
                <h3><%= stats.partiesCount %></h3>
                <p><%= __('Total Party') %></p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-users-gear"></i>
            </div>
            <a href="/master/party" class="small-box-footer">
                More info <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    
    <!-- Products Box -->
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3><%= stats.productsCount %></h3>
                <p><%= __('Total Products') %></p>
            </div>
            <div class="icon">
                <i class="fa-solid fa-box-open"></i>
            </div>
            <a href="/master/products" class="small-box-footer">
                More info <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Main Row -->
<div class="row">
    <!-- Chart Column -->
    <div class="col-md-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-chart-bar me-2 text-primary"></i>Monthly Sales Trend</span>
                <span class="badge bg-light text-dark">FY <%= activeYear %></span>
            </div>
            <div class="card-body">
                <div style="height: 300px; position: relative;">
                    <canvas id="salesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Outstanding Receivables/Payables Column -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <span><i class="fa-solid fa-pie-chart me-2 text-warning"></i>Outstanding Overview</span>
            </div>
            <div class="card-body">
                <div style="height: 200px; position: relative; margin-bottom: 20px;">
                    <canvas id="outstandingChart"></canvas>
                </div>
                <div class="d-flex justify-content-around text-center">
                    <div>
                        <h6 class="text-success"><%= __('Outstanding Receivables') %></h6>
                        <span class="fs-5 fw-bold text-success">₹<%= stats.totalReceivables.toFixed(2) %></span>
                    </div>
                    <div class="border-start mx-3"></div>
                    <div>
                        <h6 class="text-danger"><%= __('Outstanding Payables') %></h6>
                        <span class="fs-5 fw-bold text-danger">₹<%= stats.totalPayables.toFixed(2) %></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Invoices Row -->
<div class="row mt-3">
    <!-- Recent Sales -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i><%= __('Recent Sales Invoices') %></span>
                <a href="/sales/bill" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><%= __('Invoice/Challan No') %></th>
                                <th><%= __('Party Name') %></th>
                                <th><%= __('Date') %></th>
                                <th class="text-end"><%= __('Grand Total') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentSales.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted p-3">No sales records found</td>
                                </tr>
                            <% } else { %>
                                <% recentSales.forEach(invoice => { %>
                                    <tr>
                                        <td>
                                            <a href="/sales/bill/print/<%= invoice.id %>" class="fw-bold text-decoration-none">
                                                <%= invoice.invoice_no %>
                                            </a>
                                            <% if (invoice.type === 'Challan') { %>
                                                <span class="badge bg-warning text-dark ms-1">Challan</span>
                                            <% } %>
                                        </td>
                                        <td><%= invoice.party_name %></td>
                                        <td><%= new Date(invoice.date).toLocaleDateString('en-GB') %></td>
                                        <td class="text-end fw-bold">₹<%= invoice.grand_total.toFixed(2) %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Purchases -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-clock-rotate-left me-2 text-success"></i><%= __('Recent Purchases') %></span>
                <a href="/purchase/bill" class="btn btn-sm btn-outline-success">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><%= __('Invoice/Challan No') %></th>
                                <th><%= __('Party Name') %></th>
                                <th><%= __('Date') %></th>
                                <th class="text-end"><%= __('Grand Total') %></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (recentPurchases.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center text-muted p-3">No purchase records found</td>
                                </tr>
                            <% } else { %>
                                <% recentPurchases.forEach(invoice => { %>
                                    <tr>
                                        <td class="fw-bold text-success"><%= invoice.invoice_no %></td>
                                        <td><%= invoice.party_name %></td>
                                        <td><%= new Date(invoice.date).toLocaleDateString('en-GB') %></td>
                                        <td class="text-end fw-bold">₹<%= invoice.grand_total.toFixed(2) %></td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Load Chart.js CDN here -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Sales Trend Chart
        const ctxSales = document.getElementById('salesChart').getContext('2d');
        const salesData = <%- JSON.stringify(chartData.sales) %>;
        const salesLabels = <%- JSON.stringify(chartData.labels) %>;
        
        new Chart(ctxSales, {
            type: 'bar',
            data: {
                labels: salesLabels,
                datasets: [{
                    label: 'Monthly Sales (₹)',
                    data: salesData,
                    backgroundColor: 'rgba(52, 152, 219, 0.75)',
                    borderColor: 'rgba(52, 152, 219, 1)',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) { return '₹' + value.toLocaleString(); }
                        }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });

        // Outstanding Receivables / Payables Chart (Doughnut)
        const ctxOut = document.getElementById('outstandingChart').getContext('2d');
        new Chart(ctxOut, {
            type: 'doughnut',
            data: {
                labels: ['Receivables (Customers)', 'Payables (Suppliers)'],
                datasets: [{
                    data: [<%= stats.totalReceivables %>, <%= stats.totalPayables %>],
                    backgroundColor: ['rgba(40, 167, 69, 0.8)', 'rgba(220, 53, 69, 0.8)'],
                    borderColor: ['#28a745', '#dc3545'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    });
</script>

<%- include('layouts/footer') %>
