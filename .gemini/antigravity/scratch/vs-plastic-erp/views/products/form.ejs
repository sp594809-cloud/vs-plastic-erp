<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3">
    <div class="col-sm-12">
        <h1 class="m-0 text-dark"><%= isEdit ? __('Edit Product') : __('Add Product') %></h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form action="<%= isEdit ? '/master/products/edit/' + product.id : '/master/products/add' %>" method="POST">
            <div class="row">
                <!-- Product Name -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Product Name') %> <span class="text-danger">*</span></label>
                    <input type="text" name="name" class="form-control" value="<%= isEdit ? product.name : '' %>" required placeholder="Enter Product Name">
                </div>

                <!-- HSN Code -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('HSN/SAC Code') %></label>
                    <input type="text" name="hsn_sac" class="form-control" value="<%= isEdit ? product.hsn_sac : '' %>" placeholder="e.g. 39011010">
                </div>

                <!-- Unit -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('Unit') %> <span class="text-danger">*</span></label>
                    <select name="unit_id" class="form-select select2" required>
                        <option value="">Select Unit</option>
                        <% units.forEach(un => { %>
                            <option value="<%= un.id %>" <%= isEdit && product.unit_id === un.id ? 'selected' : '' %>><%= un.name %></option>
                        <% }) %>
                    </select>
                </div>

                <!-- Tax Rate -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('Tax Percentage') %> <span class="text-danger">*</span></label>
                    <select name="tax_id" class="form-select select2" required>
                        <option value="">Select Tax</option>
                        <% taxes.forEach(tx => { %>
                            <option value="<%= tx.id %>" <%= isEdit && product.tax_id === tx.id ? 'selected' : '' %>><%= tx.name %> (<%= tx.rate_percent %>%)</option>
                        <% }) %>
                    </select>
                </div>

                <!-- Opening Stock -->
                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold"><%= __('Opening Stock') %></label>
                    <input type="number" step="0.01" name="opening_stock" class="form-control" value="<%= isEdit ? product.opening_stock : '0.00' %>" <%= isEdit ? 'readonly' : '' %>>
                    <% if (isEdit) { %>
                        <small class="text-muted">Opening stock cannot be modified directly. Adjust via transactions or stock ledger.</small>
                    <% } %>
                </div>

                <!-- Purchase Rate -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Purchase Rate') %> (₹) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" name="purchase_rate" class="form-control" value="<%= isEdit ? product.purchase_rate : '0.00' %>" required>
                </div>

                <!-- Sale Rate -->
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold"><%= __('Sale Rate') %> (₹) <span class="text-danger">*</span></label>
                    <input type="number" step="0.01" name="sale_rate" class="form-control" value="<%= isEdit ? product.sale_rate : '0.00' %>" required>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4 border-top pt-3 text-end">
                <a href="/master/products" class="btn btn-secondary me-2"><%= __('Cancel') %></a>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i><%= __('Save') %>
                </button>
            </div>
        </form>
    </div>
</div>

<%- include('../layouts/header') %>
