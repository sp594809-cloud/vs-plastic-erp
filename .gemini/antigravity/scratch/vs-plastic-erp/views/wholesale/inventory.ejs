<%- include('header') %><section><span class="eyebrow blue">AHMEDABAD WAREHOUSE</span><h1>Inventory with a clear trail.</h1><p class="muted">Requests do not deduct stock. Stock is reserved at Awaiting Payment and deducted at dispatch. Cancelled reserved orders release their stock.</p><div class="table-wrap"><table><thead><tr><th>Product</th><th>Physical</th><th>Reserved</th><th>Available</th><th>Low-stock threshold</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><%= p.name %> <small><%= p.sku %></small></td><td><%= p.stock %></td><td><%= p.reserved %></td><td><%= p.stock-p.reserved %></td><td><%= p.threshold %></td></tr><% }) %></tbody></table></div><form class="panel form-grid" method="post" action="/admin/inventory"><h2 class="full">Record stock adjustment</h2><input type="hidden" name="csrf" value="<%= csrf %>"><label>Product<select name="product_id"><% products.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> (<%= p.sku %>)</option><% }) %></select></label><label>Quantity change (+ add, − reduce)<input name="delta" type="number" required></label><label>Set low-stock threshold<input name="threshold" type="number" min="0" value="0" required></label><label>Reason<input name="reason" required maxlength="1000"></label><button>Record adjustment</button></form><div class="panel"><h2>Movement history</h2><% movements.forEach(m=>{ %><div class="list-row"><span><strong><%= m.name %> · <%= m.delta>0?'+':'' %><%= m.delta %></strong><small><%= m.reason %></small></span><small><%= m.created_at.slice(0,10) %></small></div><% }) %></div></section><%- include('footer') %>
