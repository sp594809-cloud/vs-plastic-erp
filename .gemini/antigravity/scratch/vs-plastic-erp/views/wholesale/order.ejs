<%- include('header') %><section><span class="eyebrow blue">ORDER DETAILS</span><div class="section-heading"><h1 class="order-ref"><%= o.reference %></h1><span class="badge"><%= o.status %></span></div><div class="actions"><a href="<%= wa('Hello, please help with order '+o.reference+'. Current status: '+o.status) %>" class="text-link">Ask about this order ↗</a><form method="post" action="/orders/<%= o.id %>/reorder"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="secondary">Reorder at current prices</button></form><% if(user.role==='admin'){ %><a class="text-link" href="tel:<%= o.phone %>">Call customer</a><a class="text-link" target="_blank" rel="noopener" href="https://wa.me/91<%= o.phone %>?text=<%= encodeURIComponent('Hello '+o.contact+', order '+o.reference+': '+o.status+'. Final quotation: '+fmt(o.total)+'. '+(o.total!==null?settings.payment:'')+(shipping?.tracking?' Tracking: '+shipping.tracking:'')) %>">Share quotation / instructions ↗</a><% } %></div><div class="two-col"><div><div class="panel"><h2>Requested products</h2><div class="table-wrap"><table><thead><tr><th>Product</th><th>Quantity</th><th>Snapshot price</th><th>Subtotal</th></tr></thead><tbody><% items.forEach(p=>{ %><tr><td><strong><%= p.name %></strong><small><%= p.sku %> <%= p.variant %></small></td><td><%= p.qty %> <%= p.unit %></td><td><%= fmt(p.price) %></td><td><%= fmt(p.price*p.qty) %></td></tr><% }) %></tbody></table></div><p class="muted">These product details were saved when the request was submitted. The final quotation below includes any agreed adjustments.</p></div><div class="panel"><h2>Order history</h2><ol class="timeline"><% history.forEach(h=>{ %><li><strong><%= h.event %></strong><small><%= new Date(h.created_at).toLocaleString('en-IN',{timeZone:'Asia/Kolkata'}) %> IST</small></li><% }) %></ol></div><% if(user.role==='admin'){ %><div class="panel"><h2>Update order status</h2><form method="post" action="/admin/orders/<%= o.id %>/status" class="stack"><input type="hidden" name="csrf" value="<%= csrf %>"><% if(transitions.length){ %><label>Next stage<select name="status"><% transitions.forEach(s=>{ %><option><%= s %></option><% }) %></select></label><p class="muted">Move to Awaiting Payment only after the customer has accepted the quotation. This reserves stock. Mark Refunded only after completing the actual refund; dispatched stock is not automatically returned.</p><button>Record status change</button><% }else{ %><p>No further transitions available.</p><% } %></form></div><% if(['Under Review','Awaiting Customer Confirmation'].includes(o.status)){ %><form method="post" action="/admin/orders/<%= o.id %>/quote" class="panel form-grid"><h2 class="full">Final quotation</h2><input type="hidden" name="csrf" value="<%= csrf %>"><% for(const [key,label]of Object.entries({subtotal:'Confirmed product subtotal',tax:'Tax amount',shipping:'Shipping charges',discount:'Discount'})){ %><label><%= label %> (₹)<input name="<%= key %>" type="number" step="0.01" min="0" value="<%= (o[key]||0)/100 %>" required></label><% } %><label class="full">Customer-visible quotation notes<textarea name="notes"><%= o.notes||'' %></textarea></label><button class="full">Save final quotation</button></form><% } %><% if(['Awaiting Payment','Payment Verification Pending'].includes(o.status)){ %><form action="/admin/orders/<%= o.id %>/payment" method="post" class="panel form-grid"><h2 class="full">Verify payment</h2><input type="hidden" name="csrf" value="<%= csrf %>"><label>Verified amount (₹)<input name="amount" type="number" step="0.01" min="0" required value="<%= (o.total||0)/100 %>"></label><label>Method<select name="method"><option>Bank transfer</option><option>UPI</option><option>Other</option></select></label><label>Bank / payment reference<input name="reference" required maxlength="160"></label><label>Payment date<input type="date" name="payment_date" required max="<%= new Date().toISOString().slice(0,10) %>"></label><label class="full">Notes<textarea name="notes"></textarea></label><label class="check full"><input type="checkbox" name="verified" value="yes" required>I independently verified this payment in the business bank/payment account.</label><button class="full">Confirm verified payment</button></form><% } %><% if(o.paid&&o.status!=='Refunded'){ %><form method="post" action="/admin/orders/<%= o.id %>/shipping" class="panel form-grid"><h2 class="full">Shipping details</h2><input type="hidden" name="csrf" value="<%= csrf %>"><label>Courier<input name="courier" required value="<%= shipping?.courier||'' %>"></label><label>Tracking number<input name="tracking" required value="<%= shipping?.tracking||'' %>"></label><label class="full">Tracking link (https)<input name="link" type="url" value="<%= shipping?.link||'' %>"></label><label>Estimated delivery<input type="date" name="estimated_date" value="<%= shipping?.estimated_date||'' %>"></label><button class="full">Save shipping details</button></form><% } %><% } %></div><aside><div class="panel"><h2>Quotation summary</h2><dl><dt>Product subtotal</dt><dd><%= fmt(o.subtotal) %></dd><dt>Tax</dt><dd><%= fmt(o.tax) %></dd><dt>Shipping</dt><dd><%= fmt(o.shipping) %></dd><dt>Discount</dt><dd><%= fmt(o.discount) %></dd><dt><strong>Final payable</strong></dt><dd><strong><%= fmt(o.total) %></strong></dd><dt>Payment</dt><dd><%= o.status==='Refunded'?'Refunded':o.paid?'Independently verified':'Pending' %></dd></dl><p class="preserve"><%= o.notes||'' %></p></div><div class="panel"><h2>Delivery details</h2><strong><%= o.business %></strong><p class="preserve"><%= o.address %></p><% if(shipping){ %><p><%= shipping.courier %> · <%= shipping.tracking %></p><% if(shipping.link){ %><a class="text-link" href="<%= shipping.link %>" rel="noopener" target="_blank">Track shipment ↗</a><% } %><p>Estimated delivery: <%= shipping.estimated_date||'To be confirmed' %></p><% }else{ %><p class="muted">Courier and tracking details will appear here after they are arranged.</p><% } %></div><% if(['Awaiting Payment','Payment Verification Pending'].includes(o.status)){ %><div class="panel"><h2>Payment instructions</h2><p class="preserve"><%= settings.payment||'Contact our team for official business payment details before paying.' %></p><% if(user.role!=='admin'&&o.status==='Awaiting Payment'){ %><form class="stack" method="post" action="/orders/<%= o.id %>/payment-reference"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Payment reference<input name="reference" required></label><button>Submit for verification</button><p class="muted">A reference does not confirm payment. Our team checks the actual account.</p></form><% } %></div><% } %><% if(payments.length){ %><div class="panel"><h2>Verified payment records</h2><% payments.forEach(p=>{ %><p><strong><%= fmt(p.amount) %></strong> · <%= p.method %><br><%= p.reference %><br><small>Verified <%= p.verified_at.slice(0,10) %></small></p><% }) %></div><% } %></aside></div></section><%- include('footer') %>
