<% for(const [key,label] of Object.entries({business:'Business name',contact:'Contact person',phone:'Mobile number (10 digits)',business_type:'Business type',city:'City',state:'State',pincode:'PIN code',address:'Complete address',gstin:'GSTIN (optional)'})){ %><label><%= label %><% if(key==='business_type'){ %><select name="<%= key %>"><% ['Curtain Showroom','Curtain Tailor','Interior Decorator','Wholesaler','Dealer','Installer','Other'].forEach(type=>{ %><option <%= values[key]===type?'selected':'' %>><%= type %></option><% }) %></select><% }else if(key==='address'){ %><textarea name="address" required maxlength="1500"><%= values.address||'' %></textarea><% }else{ %><input name="<%= key %>" value="<%= values[key]||'' %>" <%= key==='gstin'?'':'required' %> maxlength="<%= key==='pincode'?6:key==='phone'?10:key==='gstin'?15:160 %>" <%= ['phone','pincode'].includes(key)?'inputmode=numeric':'' %>><% } %></label><% } %>
