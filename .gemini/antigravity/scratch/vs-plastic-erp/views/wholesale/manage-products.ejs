<%- include('header') %><section><div class="section-heading"><div><span class="eyebrow blue">CATALOGUE OPERATIONS</span><h1>Products & pricing</h1></div><a class="button" href="/admin/products/new">Add product +</a></div><p class="muted">Initial entries have no selling price or available stock. Set real business values before accepting orders. Create each sellable variant as a separate SKU.</p><div class="table-wrap"><table><thead><tr><th>Product</th><th>SKU / variant</th><th>Base price</th><th>MOQ</th><th>Available</th><th>Visibility</th></tr></thead><tbody><% products.forEach(p=>{ %><tr><td><a href="/admin/products/<%= p.id %>"><%= p.name %> ↗</a></td><td><%= p.sku %><small><%= p.variant %></small></td><td><%= fmt(p.price) %> / <%= p.unit %></td><td><%= p.moq %></td><td><%= p.stock-p.reserved %></td><td><%= p.active?'Published':'Archived' %></td></tr><% }) %></tbody></table></div></section><%- include('footer') %>
