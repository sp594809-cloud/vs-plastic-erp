<%- include('khata-head') %><div class="intro"><small>SMART KHATA & COLLECTIONS</small><h1><%= mode==='calls'?"Today's collection calls":"Collections overview" %></h1><p><%= new Intl.DateTimeFormat('en-IN',{dateStyle:'full',timeZone:'Asia/Kolkata'}).format(new Date(day+'T12:00:00Z')) %></p></div>
<% if(mode==='overview'){ %><div class="metrics"><% for(const [label,value] of [['Total outstanding',metrics.out],['Overdue balance',metrics.overdue],['Collected today',metrics.today],['Due today',metrics.due]]){ %><article><small><%= label %></small><strong><%= fmt(value) %></strong></article><% } %></div><div class="columns"><section><h2>Receivables aging</h2><% ['Current / due today','1–7 days','8–15 days','16–30 days','31–60 days','61–90 days','Over 90 days'].forEach((label,i)=>{ %><div class="aging"><span><%= label %></span><meter min="0" max="<%= Math.max(1,...aging) %>" value="<%= aging[i] %>"></meter><b><%= fmt(aging[i]) %></b></div><% }) %></section><section><h2>This month</h2><dl><dt>Credit sales</dt><dd><%= fmt(metrics.sales) %></dd><dt>Collections</dt><dd><%= fmt(metrics.month) %></dd><dt>Over limit</dt><dd><%= list.filter(c=>c.balance>(c.limit_paise??0)).length %></dd><dt>Promises due</dt><dd><%= calls.filter(c=>c.promise).length %></dd></dl></section></div>
<section id="customers"><h2>Customer accounts <small><%= count %></small></h2><form method="get" class="inline"><input type="search" name="q" value="<%= q %>" placeholder="Shop, contact, mobile or customer ID" aria-label="Search customers"><button>Search</button></form><% for(const c of list){ %><a class="row" href="/khata/<%= c.id %>"><span><b><%= c.business %></b><small><%= c.phone %> · <%= c.city %></small></span><span><%= fmt(c.balance) %> ↗</span></a><% } if(!list.length){ %><p>No matching customer accounts.</p><% } %></section><% } %>
<section><h2>Collection queue <small><%= calls.length %></small></h2><p>Due promises first, followed by the oldest overdue balances.</p><% for(const c of calls){ %><a class="row" href="/khata/<%= c.id %>#follow"><span><b><%= c.business %></b><small><%= c.promise?'Promise due · ':'' %><%= c.maxDays %> days overdue · <%= c.phone %></small></span><strong><%= fmt(c.balance) %> ↗</strong></a><% } if(!calls.length){ %><p>No collection calls due today.</p><% } %></section></main></body></html>
