<%- include('header') %><section><span class="eyebrow blue">YOUR WHOLESALE ORDER</span><h1>A few details, then we’re on it.</h1><p class="muted">Final order amount, applicable taxes, shipping charges and availability will be confirmed before payment.</p><% if(!cart.rows.length){ %><div class="empty"><h2>Your cart is ready for a fresh start.</h2><a class="button" href="/products">Browse products ↗</a></div><% }else{ %><div class="two-col"><div><% cart.rows.forEach(p=>{ %><article class="panel cart-item"><div><span class="eyebrow"><%= p.sku %></span><h3><%= p.name %></h3><p><%= p.variant %> · <%= p.unit %></p><p><%= p.quoted===null?'Price unavailable':fmt(p.quoted)+' each' %></p><% if(!p.valid){ %><p class="error">Review this item: price, stock or quantity is unavailable.</p><% } %></div><form method="post" action="/cart" class="stack"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="product_id" value="<%= p.id %>"><label>Quantity (0 to remove)<input type="number" name="qty" value="<%= p.qty %>" min="0" required></label><button class="secondary">Update</button><strong><%= fmt((p.quoted||0)*p.qty) %></strong></form></article><% }) %><a href="/products" class="text-link">← Continue shopping</a></div><form action="/orders" method="post" class="panel stack"><h2>Review your request</h2><input type="hidden" name="csrf" value="<%= csrf %>"><dl><dt>Business</dt><dd><%= user.business %></dd><dt>Contact</dt><dd><%= user.phone %></dd><dt>Estimated subtotal</dt><dd><%= fmt(cart.subtotal) %></dd><dt>Estimated tax</dt><dd><%= fmt(cart.tax) %></dd><dt>Shipping</dt><dd>To be confirmed</dd><dt>Final payable</dt><dd>Pending confirmation</dd></dl><% if(settings.minimum){ %><p>Minimum product value: <%= fmt(settings.minimum) %></p><% } %><% if(addresses.length){ %><label>Use a saved address<select id="saved-address"><option value="">Select an address</option><% addresses.forEach(a=>{ %><option value="<%= a.address %>"><%= a.label %></option><% }) %></select></label><% } %><label>Recipient, phone and full delivery address<textarea id="delivery-address" name="address" required maxlength="2000"><%= user.contact+' · '+user.business+' · '+user.phone+'\n'+user.address+', '+user.city+', '+user.state+' '+user.pincode %></textarea></label><button <%= cart.rows.some(p=>!p.valid)||cart.subtotal<(settings.minimum||0)?'disabled':'' %>>Submit Wholesale Order Request ↗</button><p class="muted">No payment now. Our team will call you to confirm the details. Submitting again after a successful request will not duplicate an emptied cart.</p></form></div><% } %></section><%- include('footer') %>
