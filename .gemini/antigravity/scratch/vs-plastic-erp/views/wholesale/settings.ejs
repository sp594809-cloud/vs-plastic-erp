<%- include('header') %><section><h1>Your business, your details.</h1><form class="panel form-grid" method="post" action="/admin/settings"><input type="hidden" name="csrf" value="<%= csrf %>"><% for(const [key,label]of Object.entries({name:'Business name',phone:'Phone (with country code)',whatsapp:'WhatsApp (with country code)',email:'Business email',address:'Business address',headline:'Homepage headline',payment:'Official payment instructions',shipping:'Shipping policy',returns:'Return & refund policy',privacy:'Privacy policy',terms:'Terms & conditions'})){ %><label class="<%= ['payment','shipping','returns','privacy','terms'].includes(key)?'full':'' %>"><%= label %><% if(['address','payment','shipping','returns','privacy','terms'].includes(key)){ %><textarea name="<%= key %>"><%= settings[key] %></textarea><% }else{ %><input name="<%= key %>" value="<%= settings[key] %>"><% } %></label><% } %><label>Minimum order value (₹)<input name="minimum" type="number" min="0" step="0.01" required value="<%= settings.minimum/100 %>"></label><button class="full">Save business settings</button></form><div class="two-col"><form class="panel stack" method="post" action="/admin/categories"><h2>Categories</h2><p><%= categories.map(c=>c.name).join(' · ') %></p><input type="hidden" name="csrf" value="<%= csrf %>"><label>New category<input name="name" required maxlength="100"></label><button>Add category</button></form><form class="panel stack" method="post" action="/admin/tiers"><h2>Pricing tiers</h2><p><%= tiers.map(t=>t.name).join(' · ') %></p><input type="hidden" name="csrf" value="<%= csrf %>"><label>New tier<input name="name" required maxlength="80"></label><button>Add tier</button></form></div></section><%- include('footer') %>
