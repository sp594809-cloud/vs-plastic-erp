<%- include('header') %><section class="auth-layout"><div class="auth-copy"><span class="eyebrow blue">GROW WITH US</span><h1><%= register?'Your next chapter starts here.':'Good to have you back.' %></h1><p class="lead"><%= register?'Join a simpler way to source curtain accessories.':'Your products, your orders, your wholesale partner.' %></p><p class="muted">Business accounts are reviewed by our team. Once approved, you can view wholesale pricing and request orders without paying upfront.</p><a class="text-link" href="<%= register?'/login':'/register' %>"><%= register?'Already registered? Sign in →':'New here? Register your business →' %></a></div><form class="panel form-grid" method="post" action="<%= register?'/register':'/login' %>"><h2 class="full"><%= register?'Register your business':'Business login' %></h2><input type="hidden" name="csrf" value="<%= csrf %>"><label class="full">Email address<input type="email" name="email" required autocomplete="email" maxlength="254"></label><label class="full">Password<input type="password" name="password" required minlength="12" maxlength="128" autocomplete="<%= register?'new-password':'current-password' %>"></label><% if(register){ %><p class="muted full">Use at least 12 characters for your password.</p><%- include('business-fields',{values:{}}) %><p class="muted full">By registering, you agree to our <a href="/policies/terms">terms</a> and <a href="/policies/privacy">privacy policy</a>.</p><% } %><button class="full"><%= register?'Submit registration →':'Sign in →' %></button><% if(!register){ %><a href="/contact" class="muted full">Need help accessing your account? Contact support.</a><% } %></form></section><%- include('footer') %>
