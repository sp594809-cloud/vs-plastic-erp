<%- include('header') %><section><h1><%= p.id?'Edit product':'Add product' %></h1><form method="post" action="/admin/products" class="panel form-grid"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= p.id||'' %>"><% for(const [key,label]of Object.entries({name:'Product name',slug:'URL slug (arabian-runner)',sku:'SKU',variant:'Variant / size / colour',material:'Material',image:'Product image HTTPS URL'})){ %><label><%= label %><input name="<%= key %>" value="<%= p[key]||'' %>" <%= ['name','slug','sku'].includes(key)?'required':'' %>></label><% } %><label>Category<select name="category_id"><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= p.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>Unit<select name="unit"><% ['pieces','packets','boxes','rolls','metres'].forEach(u=>{ %><option <%= p.unit===u?'selected':'' %>><%= u %></option><% }) %></select></label><label>Base price (₹, blank if unconfigured)<input name="price" type="number" step="0.01" min="0" value="<%= p.price==null?'':p.price/100 %>"></label><label>Cost (₹, optional)<input name="cost" type="number" step="0.01" min="0" value="<%= p.cost==null?'':p.cost/100 %>"></label><label>Minimum order quantity<input name="moq" type="number" min="1" required value="<%= p.moq %>"></label><label>Quantity increment<input name="step" type="number" min="1" required value="<%= p.step %>"></label><label>Tax rate (%)<input name="tax" type="number" step="0.01" min="0" max="100" required value="<%= p.tax/100 %>"></label><label>Visibility<select name="active"><option value="1" <%= p.active?'selected':'' %>>Published</option><option value="0" <%= !p.active?'selected':'' %>>Archived</option></select></label><label>Homepage featured<select name="featured"><option value="1" <%= p.featured?'selected':'' %>>Yes</option><option value="0" <%= !p.featured?'selected':'' %>>No</option></select></label><label class="full">Description<textarea name="description"><%= p.description||'' %></textarea></label><button class="full">Save product</button></form><% if(p.id){ %><div class="panel"><h2>Product photograph</h2><form id="image-upload" class="stack" data-product="<%= p.id %>" data-csrf="<%= csrf %>"><label>PNG, JPEG or WebP · maximum 2 MB<input type="file" name="image" accept="image/png,image/jpeg,image/webp" required></label><button>Upload photograph</button><p id="upload-result" role="status"></p></form></div><div class="panel"><h2>Pricing rules</h2><p class="muted">Customer-specific rules take priority, then tier rules, then general quantity rules, then base price. Within a group, the highest eligible minimum quantity wins. Remove obsolete rules before replacing them.</p><% rules.forEach(r=>{ %><div class="list-row"><span>Min <%= r.min_qty %> · <%= fmt(r.price) %> · Customer <%= r.user_id||'all' %> · Tier <%= r.tier_id||'all' %></span><form method="post" action="/admin/prices/<%= r.id %>/delete"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="secondary">Remove</button></form></div><% }) %><form method="post" action="/admin/prices" class="form-grid"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="product_id" value="<%= p.id %>"><label>Pricing tier<select name="tier_id"><option value="">All tiers</option><% tiers.forEach(t=>{ %><option value="<%= t.id %>"><%= t.name %></option><% }) %></select></label><label>Customer ID (optional)<input name="user_id" type="number" min="1"></label><label>Minimum quantity<input name="min_qty" type="number" min="1" value="1" required></label><label>Unit price (₹)<input name="price" type="number" step="0.01" min="0" required></label><button>Add rule</button></form></div><% } %></section><%- include('footer') %>
