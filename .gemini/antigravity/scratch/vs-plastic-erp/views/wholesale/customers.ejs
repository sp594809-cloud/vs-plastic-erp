<%- include('header') %><section><div class="section-heading"><h1>Business customers</h1><a href="/admin/export/customers" class="button secondary">Export CSV</a></div><form class="filters"><input name="q" placeholder="Business, email, city, state or type" aria-label="Search customers" value="<%= query.q||'' %>"><select name="status" aria-label="Approval status"><option value="">All statuses</option><% ['pending','approved','suspended','rejected'].forEach(s=>{ %><option <%= query.status===s?'selected':'' %>><%= s %></option><% }) %></select><button>Filter</button></form><% customers.forEach(c=>{ %><article class="panel"><div class="section-heading"><div><span class="eyebrow">CUSTOMER #<%= c.id %></span><h2><%= c.business %></h2><p><%= c.contact %> · <%= c.business_type %><br><%= c.city %>, <%= c.state %> <%= c.pincode %><br><%= c.email %> · <a href="tel:<%= c.phone %>"><%= c.phone %></a></p></div><span class="badge"><%= c.status %></span></div><p><%= c.address %> · GSTIN: <%= c.gstin||'Not provided' %></p><form method="post" action="/admin/customers/<%= c.id %>" class="form-grid"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Account status<select name="status"><% ['pending','approved','suspended','rejected'].forEach(s=>{ %><option <%= c.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Pricing tier<select name="tier_id"><% tiers.forEach(t=>{ %><option value="<%= t.id %>" <%= c.tier_id===t.id?'selected':'' %>><%= t.name %></option><% }) %></select></label><label class="full">Internal notes<textarea name="notes"><%= c.notes||'' %></textarea></label><button>Save customer</button></form></article><% }) %><% if(!customers.length){ %><div class="empty">No matching customers.</div><% } %></section><%- include('footer') %>
