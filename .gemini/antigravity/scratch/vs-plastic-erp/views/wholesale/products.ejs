<%- include('header') %><section><div class="page-heading"><span class="eyebrow blue">THE WHOLESALE COLLECTION</span><h1><%= title==='Saved products'?title:'Find your next essential.' %></h1><p>Thoughtful fittings for every curtain business.</p></div><form class="filters" method="get" action="/products"><input name="q" aria-label="Search products" placeholder="Search by name, SKU or material" value="<%= query.q||'' %>"><select name="category" aria-label="Category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= String(query.category)===String(c.id)?'selected':'' %>><%= c.name %></option><% }) %></select><select name="sort" aria-label="Sort"><option value="name">Name</option><option value="newest" <%= query.sort==='newest'?'selected':'' %>>Newest</option><% if(user?.status==='approved'){ %><option value="price" <%= query.sort==='price'?'selected':'' %>>Price: low to high</option><% } %></select><label class="check"><input type="checkbox" name="available" value="1" <%= query.available==='1'?'checked':'' %>>Available</label><button>Search</button></form><p class="muted"><%= products.length %> products · Prices available to approved businesses</p><div class="product-grid"><% products.forEach(p=>{ %><%- include('card',{p}) %><% }) %></div><% if(!products.length){ %><div class="empty">No products match your search. Try another category or search term.</div><% } %></section><%- include('footer') %>
