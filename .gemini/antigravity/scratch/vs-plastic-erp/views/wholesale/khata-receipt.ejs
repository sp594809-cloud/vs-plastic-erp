<%- include('khata-head') %><div class="intro"><small>VS PLASTIC</small><h1>Payment receipt</h1><p>Receipt #<%= e.id %> · <%= e.posted %></p></div><section><h2><%= c.business %></h2><% if(voided){ %><p class="notice">Reversed by correction #<%= voided.id %></p><% } %><dl><dt>Amount received</dt><dd><%= fmt(e.amount) %></dd><dt>Method</dt><dd><%= e.method %></dd><dt>Reference</dt><dd><%= e.reference||'—' %></dd><dt>Recorded by</dt><dd>#<%= e.actor %></dd></dl><p><%= e.note %></p><button id="print">Print / PDF</button></section></main></body></html>
