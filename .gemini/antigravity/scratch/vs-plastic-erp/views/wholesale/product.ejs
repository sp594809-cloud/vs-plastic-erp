<%- include('header') %><section><a class="text-link" href="/products">← Back to catalogue</a><div class="detail-grid"><div class="product-visual"><img src="<%= p.image||'/wholesale/product-'+(p.category_id<=5?p.category_id:1)+'.svg' %>" alt="<%= p.image?p.name:'Placeholder illustration for '+p.name %>"><% if(!p.image){ %><p>Illustration placeholder · Product photograph coming soon</p><% } %></div><div><span class="eyebrow blue"><%= p.sku %></span><h1><%= p.name %></h1><p class="lead"><%= p.variant %></p><p class="muted"><%= p.description %></p><dl><dt>Unit</dt><dd><%= p.unit %></dd><dt>Minimum order</dt><dd><%= p.moq %> <%= p.unit %></dd><dt>Quantity increment</dt><dd><%= p.step %></dd><dt>Material</dt><dd><%= p.material||'Ask our team' %></dd><dt>Availability</dt><dd><%= p.stock>p.reserved?'Available, subject to confirmation':'Contact us for availability' %></dd></dl><% if(user?.status==='approved'){ %><h2><%= p.quoted===null?'Price on request':fmt(p.quoted)+' / '+p.unit %></h2><% if(p.quoted!==null){ %><form method="post" action="/cart" class="inline-form"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="product_id" value="<%= p.id %>"><label>Quantity<input type="number" name="qty" min="<%= p.moq %>" step="<%= p.step %>" value="<%= p.moq %>" required></label><button>Add to cart ↗</button></form><p class="muted">Tax and delivery are confirmed with your final quotation. Quantity discounts, if configured, apply in your cart.</p><% } %><% }else{ %><div class="notice">Wholesale prices are available after business approval.</div><a class="button" href="/register">Register as a wholesale buyer</a><% } %><div class="actions"><a class="text-link" href="<%= wa('Hello, please share specifications and a quotation for '+p.name+' ('+p.sku+').') %>">Ask about this product ↗</a><% if(user){ %><form action="/saved/<%= p.id %>" method="post"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="secondary">Save / unsave</button></form><% } %></div></div></div></section><%- include('footer') %>
