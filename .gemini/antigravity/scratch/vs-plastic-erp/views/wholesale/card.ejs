<article class="product-card"><a class="product-image" href="/products/<%= p.slug %>"><% if(p.image){ %><img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"><% }else{ %><img src="/wholesale/product-<%= p.category_id<=5?p.category_id:1 %>.svg" alt="Illustration placeholder for <%= p.name %>" loading="lazy"><span class="image-note">Illustration · photo coming soon</span><% } %></a><div class="product-copy"><span class="eyebrow"><%= p.sku %> <%= p.variant?'· '+p.variant:'' %></span><h3><a href="/products/<%= p.slug %>"><%= p.name %></a></h3><p><%= p.unit %> · Minimum <%= p.moq %></p><div class="card-bottom"><span><% if(user?.status==='approved' && p.quoted!==undefined){ %><%= p.quoted===null?'Price on request':fmt(p.quoted)+' / '+p.unit %><% }else{ %>Approved buyer pricing<% } %></span><a href="/products/<%= p.slug %>" aria-label="View <%= p.name %>">↗</a></div></div></article>
