<%- include('header') %><section><h1>Sales, grounded in real orders.</h1><form class="filters"><label>Orders from<input type="date" name="from" value="<%= query.from||'' %>"></label><label>Orders to<input type="date" name="to" value="<%= query.to||'' %>"></label><button>Apply dates</button><a href="/admin/export/orders" class="text-link">Export all orders CSV ↗</a></form><% const paid=orders.filter(o=>o.paid&&o.status!=='Refunded');const total=paid.reduce((s,o)=>s+o.total,0);const counts={};paid.forEach(o=>counts[o.user_id]=(counts[o.user_id]||0)+1); %><div class="stats"><% [['Verified sales',fmt(total)],['Completed order value',fmt(paid.filter(o=>o.status==='Completed').reduce((s,o)=>s+o.total,0))],['Average paid order',fmt(paid.length?total/paid.length:0)],['Repeat buyer rate',(Object.keys(counts).length?Math.round(Object.values(counts).filter(v=>v>1).length/Object.keys(counts).length*100):0)+'%']].forEach(([label,value])=>{ %><div class="stat"><span><%= label %></span><strong><%= value %></strong></div><% }) %></div><p class="muted">Sales include tax and shipping and exclude refunded orders. Date filters use order creation dates. These figures are not net profit.</p><div class="two-col"><% for(const key of ['city','state']){const grouped={};paid.forEach(o=>grouped[o[key]]=(grouped[o[key]]||0)+o.total); %><div class="panel"><h2>Sales by <%= key %></h2><% Object.entries(grouped).sort((a,b)=>b[1]-a[1]).forEach(([label,value])=>{ %><div class="list-row"><span><%= label %></span><strong><%= fmt(value) %></strong></div><% }) %></div><% } %></div><div class="panel"><h2>Monthly verified sales</h2><% const months={};paid.forEach(o=>months[o.created_at.slice(0,7)]=(months[o.created_at.slice(0,7)]||0)+o.total);Object.entries(months).sort().forEach(([month,value])=>{ %><div class="list-row"><span><%= month %></span><strong><%= fmt(value) %></strong></div><% }) %><% if(!paid.length){ %><p class="muted">Verified sales will appear here once actual payments have been recorded.</p><% } %></div><div class="stats"><div class="stat"><span>Pending estimated product value</span><strong><%= fmt(orders.filter(o=>!o.paid&&!['Cancelled','Rejected'].includes(o.status)).reduce((s,o)=>s+o.subtotal,0)) %></strong></div><div class="stat"><span>Cancelled orders</span><strong><%= orders.filter(o=>o.status==='Cancelled').length %></strong></div></div></section><%- include('footer') %>
