<%- include('header') %><section><span class="eyebrow blue">BUSINESS OVERVIEW</span><h1>A clear view of what’s next.</h1><div class="stats"><% const metrics=[['Customers',customers.length],['Pending approvals',customers.filter(c=>c.status==='pending').length],['Order requests',orders.length],['Verified sales',fmt(orders.filter(o=>o.paid&&o.status!=='Refunded').reduce((s,o)=>s+o.total,0))]];metrics.forEach(([label,value])=>{ %><div class="stat"><span><%= label %></span><strong><%= value %></strong></div><% }) %></div><p class="muted">Verified sales exclude unpaid requests and refunded orders. Amounts include confirmed tax and shipping.</p><div class="two-col"><div class="panel"><div class="section-heading"><h2>Latest orders</h2><a href="/admin/orders">View all ↗</a></div><% orders.slice(0,8).forEach(o=>{ %><a class="list-row" href="/orders/<%= o.id %>"><span><strong><%= o.business %></strong><small><%= o.reference %></small></span><span class="badge"><%= o.status %></span></a><% }) %><% if(!orders.length){ %><p class="muted">Order requests appear here when buyers submit them.</p><% } %></div><div class="panel"><h2>Needs your attention</h2><a class="list-row" href="/admin/customers?status=pending">Business approvals <b><%= customers.filter(c=>c.status==='pending').length %> ↗</b></a><a class="list-row" href="/admin/orders?status=Payment%20Verification%20Pending">Payment verification <b><%= orders.filter(o=>o.status==='Payment Verification Pending').length %> ↗</b></a><a class="list-row" href="/admin/inventory">Low stock items <b><%= low.length %> ↗</b></a><a class="list-row" href="/admin/orders?status=Processing">Ready to process <b><%= orders.filter(o=>o.status==='Processing').length %> ↗</b></a></div></div><div class="panel"><h2>Recent admin activity</h2><% audit.forEach(a=>{ %><div class="list-row"><span><%= a.event %></span><small><%= a.created_at.slice(0,19).replace('T',' ') %> UTC</small></div><% }) %></div></section><%- include('footer') %>
