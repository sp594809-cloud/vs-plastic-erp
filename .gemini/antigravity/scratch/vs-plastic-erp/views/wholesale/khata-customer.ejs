<%- include('khata-head') %><div class="intro"><small>CUSTOMER #<%= c.id %> · <%= c.city %></small><h1><%= c.business %></h1><p><%= c.contact %> · <a href="tel:<%= c.phone %>"><%= c.phone %></a></p></div>
<div class="metrics"><% for(const [label,value] of [['Outstanding',state.balance],['Approved limit',c.limit_paise||0],['Credit purchases',state.sales],['Payments received',state.payments]]){ %><article><small><%= label %></small><strong><%= fmt(value) %></strong></article><% } %></div><p class="notice"><b><%= state.risk %> risk</b> · Oldest overdue balance is <%= state.maxDays %> days late. Credit requires review above <%= fmt(c.limit_paise||0) %> or after <%= c.block_days??7 %> overdue days.</p>
<div class="columns"><% for(const [kind,label] of [['sale','Quick credit sale'],['payment','Receive payment']]){ if(kind==='sale'&&user.role==='accountant'||kind==='payment'&&!['admin','accountant'].includes(user.role))continue; %><section><h2><%= label %></h2><form method="post" action="/khata/<%= c.id %>/entry"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= key() %>"><input type="hidden" name="kind" value="<%= kind %>"><label>Amount (₹)<input required name="amount" inputmode="decimal" placeholder="0.00"></label><% if(kind==='sale'){ %><label>Due date<input required type="date" name="due" value="<%= due %>"></label><% }else{ %><label>Method<select name="method"><% for(const m of ['UPI','cash','bank','cheque','other']){ %><option><%= m %></option><% } %></select></label><label>Payment date<input name="posted" type="date" max="<%= day %>" value="<%= day %>"></label><label>Payment reference<input name="reference" maxlength="100"></label><% } %><label>Note<input name="note" maxlength="500"></label><button><%= label %></button></form></section><% } %></div>
<section><h2>Customer ledger</h2><form class="inline"><label>From<input name="from" type="date" value="<%= query.from||'' %>"></label><label>To<input name="to" type="date" value="<%= query.to||'' %>"></label><label>Type<select name="kind"><option value="">All entries</option><% for(const t of ['sale','payment','refund','credit_note','reversal']){ %><option <%= query.kind===t?'selected':'' %>><%= t %></option><% } %></select></label><button>Filter</button><button name="csv" value="1">CSV</button><button type="button" id="print">Print / PDF</button></form><div class="scroll"><table><thead><tr><th>Date / ID</th><th>Entry</th><th>Note / Reference</th><th>Change</th><th>Balance</th></tr></thead><tbody><% for(const e of rows){ %><tr><td><%= e.posted %> #<%= e.id %></td><td><%= e.kind %> <%= e.method||'' %></td><td><%= e.note %> <%= e.reference||'' %></td><td><%= fmt(e.delta) %></td><td><%= fmt(e.balance) %></td></tr><% } %></tbody></table></div><% if(!rows.length){ %><p>No entries for this period.</p><% } %></section>
<section id="follow"><h2>Collection follow-up</h2><a href="tel:<%= c.phone %>">Call customer</a> <% if(c.consent&&state.balance>0){ %> · <a href="https://wa.me/91<%= c.phone %>?text=<%= encodeURIComponent('નમસ્કાર '+c.business+', અમારા હિસાબ મુજબ તમારા '+fmt(state.balance)+' બાકી છે. કૃપા કરીને અનુકૂળ સમયે પેમેન્ટ કરી આપશો. આભાર — VS Plastic.') %>">Open WhatsApp message</a><% } %><form method="post" action="/khata/<%= c.id %>/contact"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Outcome<select name="kind"><% for(const type of ['attempt','promise','reschedule','dispute','resolved','cancel']){ %><option><%= type %></option><% } %></select></label><div class="inline"><label>Promised amount (₹)<input name="amount" inputmode="decimal"></label><label>Follow-up date<input type="date" name="date" min="<%= day %>"></label></div><label>Contact notes<input required maxlength="500" name="note"></label><button>Record outcome</button></form><% for(const p of contacts){ %><div class="row"><span><b><%= p.kind %></b> · <%= p.note %><small><%= p.created_at.slice(0,10) %> · Staff #<%= p.actor %></small></span><span><%= p.follow_date %> <% if(p.kind==='promise'){ %><%= fmt(p.amount) %> · <%= remaining(p)===0?'Fulfilled':remaining(p)<p.amount?'Part paid':p.follow_date<day?'Missed':'Pending' %><% } %></span></div><% } %></section>
<section><h2>Credit approvals</h2><% if(!requests.length){ %><p>No credit requests.</p><% } for(const r of requests){ %><div class="row"><span>#<%= r.id %> · <%= fmt(r.amount) %> · <%= r.status %><small><%= r.note %> <%= r.reason %></small></span></div><% if(user.role==='admin'&&r.status==='pending'){ %><form method="post" action="/khata/<%= c.id %>/review"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="request" value="<%= r.id %>"><input required name="reason" placeholder="Decision reason"><div><button name="status" value="approved">Approve and post</button> <button name="status" value="rejected">Reject</button></div></form><% } } %></section>
<% if(user.role==='admin'){ %><section><details><summary>Credit policy & messaging consent</summary><form method="post" action="/khata/<%= c.id %>/policy"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Limit (₹)<input required name="limit" value="<%= (c.limit_paise||0)/100 %>"></label><label>Payment terms in days<input required name="terms" value="<%= c.terms??14 %>"></label><label>Block credit after overdue days<input required name="block" value="<%= c.block_days??7 %>"></label><label>Assigned staff ID<input name="assigned" value="<%= c.assigned||'' %>"></label><label><input type="checkbox" name="consent" value="yes" <%= c.consent?'checked':'' %>> Customer consented to WhatsApp payment reminders</label><button>Save policy</button></form></details></section><% } %>
<% if(['admin','accountant'].includes(user.role)){ %><section><details><summary>Accounting corrections</summary><form method="post" data-confirm="Record this correction permanently?" action="/khata/<%= c.id %>/entry"><input type="hidden" name="csrf" value="<%= csrf %>"><input type="hidden" name="key" value="<%= key() %>"><label>Correction<select name="kind"><option>credit_note</option><option>refund</option><option>reversal</option></select></label><label>Amount for refund or credit note<input name="amount" inputmode="decimal"></label><label>Original entry ID for reversal<input name="original" type="number"></label><label>Refund method<select name="method"><option>cash</option><option>UPI</option><option>bank</option><option>cheque</option><option>other</option></select></label><label>Reason<input required name="note"></label><button>Record correction</button></form></details></section><% } %></main></body></html>
