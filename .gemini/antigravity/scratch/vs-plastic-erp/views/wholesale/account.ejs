<%- include('header') %><section><span class="eyebrow blue">YOUR BUSINESS ACCOUNT</span><h1>Hello, <%= user.contact %>.</h1><div class="actions"><span class="badge"><%= user.status %></span><a href="/orders" class="button">My orders ↗</a><a href="/saved" class="text-link">Saved products</a><form method="post" action="/logout"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="secondary">Sign out</button></form></div><% if(user.status!=='approved'){ %><div class="notice">Our team is reviewing your business. Pricing and order requests become available after approval.</div><% } %><div class="two-col"><form method="post" action="/account" class="panel form-grid"><h2 class="full">Business details</h2><input type="hidden" name="csrf" value="<%= csrf %>"><%- include('business-fields',{values:user}) %><button class="full">Save details</button></form><div><div class="panel"><h2>Delivery addresses</h2><% addresses.forEach(a=>{ %><div class="address"><strong><%= a.label %></strong><p><%= a.address %></p><form method="post" action="/addresses/<%= a.id %>/delete"><input type="hidden" name="csrf" value="<%= csrf %>"><button class="secondary">Remove</button></form></div><% }) %><form method="post" action="/addresses" class="stack"><input type="hidden" name="csrf" value="<%= csrf %>"><label>Address label<input name="label" required placeholder="Main shop"></label><label>Recipient, mobile and complete address<textarea name="address" required></textarea></label><button>Save address</button></form></div><form action="/account/password" method="post" class="panel stack"><h2>Change password</h2><input type="hidden" name="csrf" value="<%= csrf %>"><label>Current password<input type="password" name="current" required autocomplete="current-password"></label><label>New password<input type="password" name="password" minlength="12" maxlength="128" required autocomplete="new-password"></label><button>Change password & sign out</button></form></div></div></section><%- include('footer') %>
