<%- include('header') %><section><div class="section-heading"><div><span class="eyebrow blue"><%= adminView?'OPERATIONS':'YOUR ACCOUNT' %></span><h1><%= adminView?'Order management':'My orders' %></h1></div><% if(adminView){ %><a class="button secondary" href="/admin/export/orders">Export CSV</a><% } %></div><% if(!orders.length){ %><div class="empty"><h2>No orders yet.</h2><a class="button" href="/products">Explore products</a></div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Order</th><% if(adminView){ %><th>Business</th><% } %><th>Status</th><th>Estimated subtotal</th><th>Final payable</th><th>Payment</th><th>Date</th></tr></thead><tbody><% orders.forEach(o=>{ %><tr><td><a href="/orders/<%= o.id %>"><%= o.reference %> ↗</a></td><% if(adminView){ %><td><%= o.business %></td><% } %><td><span class="badge"><%= o.status %></span></td><td><%= fmt(o.subtotal) %></td><td><%= fmt(o.total) %></td><td><%= o.status==='Refunded'?'Refunded':o.paid?'Verified':'Unpaid' %></td><td><%= o.created_at.slice(0,10) %></td></tr><% }) %></tbody></table></div><% } %></section><%- include('footer') %>
