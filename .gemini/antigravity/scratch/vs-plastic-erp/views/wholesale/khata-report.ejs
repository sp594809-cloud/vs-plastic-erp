<%- include('khata-head') %><div class="intro"><small>SMART KHATA</small><h1>Receivables report</h1><p>Sales and payments cover the selected dates. Balances show exposure at the end of the period.</p></div><section><form class="inline"><% for(const [key,value] of [['from',from],['to',to],['city',q.city],['area',q.area],['category',q.category],['assigned',q.assigned]]){ %><label><%= key %><input name="<%= key %>" type="<%= ['from','to'].includes(key)?'date':'text' %>" value="<%= value||'' %>"></label><% } %><button>Apply</button><button name="format" value="csv">CSV</button><button name="format" value="excel">Excel XML</button><button id="print" type="button">Print / PDF</button></form></section><section><div class="scroll"><table><thead><tr><% labels.forEach(l=>{ %><th><%= l %></th><% }) %></tr></thead><tbody><% rows.forEach(r=>{ %><tr><% r.forEach(v=>{ %><td><%= v??'—' %></td><% }) %></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p>No accounts match these filters.</p><% } %></section></main></body></html>
