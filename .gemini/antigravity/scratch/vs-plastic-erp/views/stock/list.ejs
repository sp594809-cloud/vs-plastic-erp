<%- include('../layouts/header') %>
<%- include('../layouts/sidebar') %>

<div class="row mb-3 align-items-center">
    <div class="col-sm-6">
        <h1 class="m-0 text-dark">Current Stock Ledger</h1>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="stockTable" class="table table-bordered table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th><%= __('Product Name') %></th>
                        <th><%= __('HSN/SAC Code') %></th>
                        <th><%= __('Unit') %></th>
                        <th class="text-end"><%= __('Opening Stock') %></th>
                        <th class="text-end">Stock In (+)</th>
                        <th class="text-end">Stock Out (-)</th>
                        <th class="text-end fw-bold"><%= __('Current Stock') %></th>
                        <th class="text-end">Avg. Value Rate</th>
                        <th class="text-end">Valuation Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <% stockItems.forEach(item => { %>
                        <% const inQty = item.in_qty || 0; %>
                        <% const outQty = item.out_qty || 0; %>
                        <% const currentStock = item.opening_stock + inQty - outQty; %>
                        <% const valuation = currentStock * item.purchase_rate; %>
                        <tr>
                            <td class="fw-bold"><%= item.name %></td>
                            <td><%= item.hsn_sac || '-' %></td>
                            <td><%= item.unit_name %></td>
                            <td class="text-end"><%= item.opening_stock.toFixed(2) %></td>
                            <td class="text-end text-success"><%= inQty.toFixed(2) %></td>
                            <td class="text-end text-danger"><%= outQty.toFixed(2) %></td>
                            <td class="text-end fw-bold">
                                <span class="<%= currentStock > 10 ? 'text-success' : 'text-danger' %>">
                                    <%= currentStock.toFixed(2) %>
                                </span>
                            </td>
                            <td class="text-end">₹<%= item.purchase_rate.toFixed(2) %></td>
                            <td class="text-end fw-bold">₹<%= valuation.toFixed(2) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        $('#stockTable').DataTable({
            language: window.dtLanguageConfig,
            dom: 'Bfrtip',
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa-solid fa-file-excel me-1"></i> Excel',
                    className: 'btn btn-success btn-sm'
                },
                {
                    extend: 'pdfHtml5',
                    text: '<i class="fa-solid fa-file-pdf me-1"></i> PDF',
                    className: 'btn btn-danger btn-sm'
                },
                {
                    extend: 'print',
                    text: '<i class="fa-solid fa-print me-1"></i> Print',
                    className: 'btn btn-dark btn-sm'
                }
            ],
            pageLength: 25,
            order: [[0, 'asc']]
        });
    });
</script>

<%- include('../layouts/footer') %>
