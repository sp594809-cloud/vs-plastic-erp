# Existing TiDB credentials: configure only in your hosting environment or local .env.
DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=vsplastic

# Production requires these values and HTTPS.
NODE_ENV=development
SESSION_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:3001
# Set to 1 only behind a trusted single reverse proxy.
TRUST_PROXY=0
PORT=3001
